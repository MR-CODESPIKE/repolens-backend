# Local dev port (Render sets PORT automatically in production)
PORT=4000

# Redis connection string (Render Key Value add-on, or local redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Your shared/default Google AI Studio Gemini API key (used for free-tier requests)
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use
GEMINI_MODEL=gemini-2.0-flash-exp

# Random 32+ character secret used to encrypt users' BYOK keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=change_this_to_a_long_random_string

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Free daily analyses per client before requiring BYOK
FREE_DAILY_LIMIT=5

# Max repo size (MB) allowed for cloning/analysis
MAX_REPO_SIZE_MB=250
